# Copy this file to .env and fill in your real values — never commit .env itself.

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/sih_db

# Groq API key (used for sentiment/emotion/sarcasm analysis in
# app/services/sentiment_service.py). Get one at https://console.groq.com/keys
# If left blank, the app runs fine but every post falls back to neutral
# sentiment/emotion — useful for offline dev, not for a real demo.
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=qwen/qwen3.6-27b

# X API v2 bearer token. Keep this in the backend environment only.
X_BEARER_TOKEN=your_x_bearer_token_here
X_DEMO_FALLBACK=true

# Optional — only needed if/when Celery or another Redis-backed queue is wired up
REDIS_URL=redis://localhost:6379/0
